<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). The foreground carries no cognac of its own —
     it is the wedges, hairline and bore only — so the background layer is what
     you actually see as the plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- API 33+ themed icons: a silhouette the system tints itself. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
